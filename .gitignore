.DS_Store

# Data — corpora and derived artifacts stay local.
# Track the directory structure, never the contents.
data/**
!data/**/
!data/**/.gitkeep

# Model/embedding caches and indexes
*.faiss
*.index
embeddings/
.cache/

# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Superseded raw evidence (summaries are kept as .md)
evals/eval_0a_fma_small_full_*.json

# Personal library — never committed, never redistributed
data/music/

# Eval outputs naming the personal library stay local
evals/*.private.json

# Embedding cache — derived, regenerable, large
.cache/

# Transcripts of the personal library are its lyrics — never committed
.cache/transcripts_*.json
