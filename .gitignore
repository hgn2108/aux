.DS_Store

# Data — corpora and derived artifacts stay local.
# Track the directory structure, never the contents.
data/**
!data/**/
!data/**/.gitkeep

# Model/embedding caches and indexes
*.faiss
*.index
embeddings/
.cache/

# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Superseded raw evidence (summaries are kept as .md)
evals/eval_0a_fma_small_full_*.json

# Personal library — never committed, never redistributed
data/music/

# Eval outputs naming the personal library stay local
evals/*.private.json

# Embedding cache — derived, regenerable, large
.cache/

# Transcripts of the personal library are its lyrics — never committed
.cache/transcripts_*.json

# ---------------------------------------------------------------------------
# Internal working documents. Local only, not part of the public repository.
# INTERVIEW.md and STUDY.md are preparation notes about this work rather than
# documentation of it, so they stay out of the repository too.
# ---------------------------------------------------------------------------
INTERVIEW.md
STUDY.md
PROJECT.md
DESIGN.md
STATUS.md
DECISIONS.md
EVALS.md
CLAUDE.md
docs/*
!docs/img/
evals/

# Editor/tooling config
.claude/

# The router query set is public -- it is the data behind a published finding, contains no
# personal content, and the result is not reproducible without it. It lives in queries/,
# which is tracked, rather than under the ignored evals/.

# The deployable corpus bundle is metadata and derived vectors only -- no audio, no
# transcripts -- and is committed so a public instance can demonstrate the lyric modality,
# which the Creative Commons corpus cannot.
!demo/
.agents/

# The exported demo bundles are committed: they are what a deployment loads, and none of
# them contains audio that is not Creative Commons.
!demo/audio/
